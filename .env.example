# Gateway service configuration
SERVER_PORT=8080

# Supabase authentication endpoint
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_JWT_ISSUER_URI=https://your-project.supabase.co/auth/v1

# History service configuration
MONGODB_URI=mongodb://user:password@host:port/database?authSource=admin

# Route Service
POSTGRES_DB=db_rutas
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka-host:9092

# Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash